# Copy this file to .env and fill in the values below. .env is your secret
# config - never share it or commit it anywhere.

# Bot tab -> Token, in https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# The text channel the bot posts/edits its status message in. Right-click it
# in Discord (Developer Mode must be on) -> Copy Channel ID.
DISCORD_STATUS_CHANNEL_ID=

# Substring (case-insensitive) matched against running process names to
# decide the game is open. Default matches WardogsClient-Win64-Shipping.exe.
GAME_PROCESS_SUBSTRING=wardogs

# How often (seconds) to screenshot+OCR while the game is running.
POLL_INTERVAL_SECONDS=2

# How often (seconds) to re-send the current status even when it hasn't
# changed, purely to refresh the "Last updated" timestamp on Discord - so
# staying on one server for a while doesn't make the message look stale.
HEARTBEAT_INTERVAL_SECONDS=300

# Screen region to OCR, as "left,top,right,bottom" fractions of the screen
# (0.0-1.0). Covers the bottom ~35%: pause-menu panel (bottom-right),
# "PRESS ANY BUTTON TO START" splash (bottom-center), and DEPLOY / SERVER
# BROWSER button (bottom-left). Smaller = faster polling. Widen to "0,0,1,1"
# (full screen) if something isn't being found - see README.

CAPTURE_REGION=0,0.65,1.0,1.0

# Small box around the team icon in the bottom-right HUD corner, same
# "left,top,right,bottom" fractions. May need adjusting on other
# resolutions / UI scales.
TEAM_ICON_REGION=0.960,0.925,0.990,0.965

# The scoreboard row (three big team scores, blue/red/green) in the
# bottom-left HUD, same "left,top,right,bottom" fractions. Cover the whole
# row of three equal-width team panels; the big digits are read from the
# left of each third. May need adjusting on other resolutions / UI scales.
SCORE_REGION=0.0169,0.9139,0.1497,0.9514

# Score-only changes are pushed to Discord at most this often (seconds),
# since scores tick up constantly. Server/team changes are never delayed.
SCORE_UPDATE_INTERVAL_SECONDS=30

# Which monitor Wardogs runs on: 1 is the primary display, 2+ are the
# others. Both regions above are fractions of this monitor. Run
# `python region_preview.py` to see each monitor's number and resolution.
MONITOR_INDEX=1

# Your name, shown in the embed title ("Current Wardogs Server - <name>")
# and in the not-in-game text ("<name> is not in a game"). Only matters if
# more than one person is posting into the same channel - see README
# "Multiple people" - it's what tells everyone's messages apart.
DISPLAY_NAME=Matrix

# Only needed if you installed Tesseract somewhere other than the default.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
